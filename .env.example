# ── ATLAS Audit Intelligence Platform — Environment Variables ──────────────────
# Copy this file to .env and fill in your values before running the server.

# Flask secret key (REQUIRED — change this to a random 32+ character string)
FLASK_SECRET_KEY=change-me-to-a-random-secure-string-in-production

# Gemini API key (OPTIONAL — enables AI-enhanced narrative in DOCX reports)
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Production settings (uncomment if deploying with gunicorn) ──────────────
# FLASK_ENV=production
# PORT=5000
